<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="stage_new" model="helpdesk.ticket.stage">
        <field name="name">New</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_in_progress" model="helpdesk.ticket.stage">
        <field name="name">In Progress</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_completed" model="helpdesk.ticket.stage">
        <field name="name">Completed</field>
        <field name="sequence">30</field>
        <field name="fold">1</field>
    </record>
    <record id="stage_cancelled" model="helpdesk.ticket.stage">
        <field name="name">Cancelled</field>
        <field name="sequence">40</field>
        <field name="fold">1</field>
    </record>
    <record id="stage_reopened" model="helpdesk.ticket.stage">
        <field name="name">Reopened</field>
        <field name="sequence">15</field>
    </record>
</odoo>
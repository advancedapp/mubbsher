<odoo>
    <record id="view_helpdesk_request_type_list" model="ir.ui.view">
        <field name="name">helpdesk.request.type.list</field>
        <field name="model">helpdesk.request.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_helpdesk_request_type" model="ir.actions.act_window">
        <field name="name">Request Types</field>
        <field name="res_model">helpdesk.request.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_helpdesk_request_type"
              name="Request Types"
              parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
              action="action_helpdesk_request_type"
              sequence="31"/>
</odoo>
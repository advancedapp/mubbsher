<!-- helpdesk_extend/views/helpdesk_ticket_views.xml -->
<odoo>
    <record id="view_helpdesk_ticket_form_inherit" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.inherit.extend</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk_mgmt.ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="service_type_id"/>
                <field name="request_type"/>
                <field name="request_subtype_id"
                       invisible="request_type != 'request'"
                       required="request_type == 'request'"/>
                <field name="reopen_reason" invisible="not reopen_reason"/>
            </xpath>
        </field>
    </record>
</odoo>
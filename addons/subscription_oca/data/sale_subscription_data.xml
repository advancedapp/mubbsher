<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="seq_id" model="ir.sequence">
            <field name="name">مرتب اشتراك المبيعات</field>
            <field name="code">sale.subscription</field>
            <field name="prefix">SUB</field>
            <field name="padding">5</field>
        </record>

        <record id="subscription_stage_draft" model="sale.subscription.stage">
            <field name="name">مسودة</field>
            <field name="sequence">0</field>
            <field name="type">draft</field>
            <field name="description">
                مسودة، لا يزال العمل جارياً على التفاصيل.
            </field>
            <field eval="False" name="fold" />
        </record>

        <record id="subscription_stage_ready" model="sale.subscription.stage">
            <field name="name">جاهز للبدء</field>
            <field name="sequence">1</field>
            <field name="type">pre</field>
            <field name="description">
                الاشتراك جاهز للبدء عندما لا يكون محدداً كقيد التنفيذ ولكن يمكن أن يبدأ في أي لحظة. إذا لم يتم تعريف مرحلة من نوع 'مغلق'، عند انتهاء الاشتراك تلقائياً، سيتم تحديده بهذه المرحلة.
            </field>
            <field eval="False" name="fold" />
        </record>

        <record id="subscription_stage_in_progress" model="sale.subscription.stage">
            <field name="name">قيد التنفيذ</field>
            <field name="sequence">2</field>
            <field name="type">in_progress</field>
            <field eval="False" name="fold" />
            <field name="description">
                كمرحلة من نوع 'قيد التنفيذ'، سيتم تشغيل عملية الفوترة المتكررة إذا كانت قابلة للتطبيق. إذا كانت هذه المرحلة هي الأولى - حسب ترتيب التسلسل - من أنواع 'قيد التنفيذ' المتاحة وكان هناك تغيير في المرحلة من أي نوع آخر غير 'قيد التنفيذ' إلى هذا النوع، سيتم إنشاء فاتورة تلقائياً إذا كان تاريخ البدء هو اليوم الحالي.
            </field>
        </record>

        <record id="subscription_stage_closed" model="sale.subscription.stage">
            <field name="name">مغلق</field>
            <field name="sequence">3</field>
            <field name="type">post</field>
            <field eval="False" name="fold" />
            <field name="description">
                المرحلة النهائية للاشتراك. هناك طريقتان لتحديد الاشتراك كمغلق. الطريقة الأسهل هي استخدام إمكانيات نقل بطاقات كانبان، بالضغط على زر 'إغلاق الاشتراك' (متاح فقط إذا كان الاشتراك قيد التنفيذ).
            </field>
        </record>
    </data>

    <record id="close_reason_expensive" model="sale.subscription.close.reason">
        <field name="name">الاشتراك مكلف جداً</field>
    </record>

    <record id="close_reason_requirement" model="sale.subscription.close.reason">
        <field name="name">الاشتراك لا يلبي متطلباتي</field>
    </record>

    <record id="close_reason_ended" model="sale.subscription.close.reason">
        <field name="name">انتهى الاشتراك</field>
    </record>

    <record id="close_reason_use" model="sale.subscription.close.reason">
        <field name="name">لا أستخدمه حقاً</field>
    </record>

    <record id="close_reason_other" model="sale.subscription.close.reason">
        <field name="name">أخرى</field>
    </record>
</odoo>